# From `supabase start` (or your Supabase project's API settings).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Used to build invitation links.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Server only, never NEXT_PUBLIC_. Lets Claude draft from a nurse text, therapy
# handoff or visit summary. Without it, those screens offer "Type it in myself".
ANTHROPIC_API_KEY=
# Reminders (push notifications). Make a key pair once with
# `pnpm exec web-push generate-vapid-keys`; the private key is server only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com
# The scheduler sends this as "Authorization: Bearer ..." to /api/reminders.
# Locally the demo seed accepts "local-reminder-secret"; elsewhere, add its hash
# to the database once (see the README).
REMINDER_SECRET=local-reminder-secret
# Shown on the privacy and terms pages so families can reach you.
CONTACT_EMAIL=
